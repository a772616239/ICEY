  - Term: "Story\x2fe6s14"
    TermType: 0
    Description: 
    Languages:
    - "Hastur"
    - "\u54C8\u65AF\u5854"
    - "\u54C8\u65AF\u5854"
    - "\u30CF\u30B9\u30BF\u30FC"
    - "Hastur"
    - "Hastur"

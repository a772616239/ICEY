    TermType: 0
    Description: 
    Languages:
    - "First, import the picture."
    - "\u5148\u8981\u5BFC\u5165\u56FE\u7247"
    - "\u5148\u8981\u5C0E\u5165\u5716\u7247"
    - "\u5148\u306B\u753B\u50CF\u3092\u9001\u4FE1"

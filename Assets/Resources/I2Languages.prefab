  - Term: "Story\x2fe23s11"
    TermType: 0
    Description: 
    Languages:
    - "Do you\nprefer a more\ndifficult journey?"
    - "\u60A8\u662F\u5426\n\u66F4\u559C\u6B22\n\u56F0\u96BE\u7684\u9053\u8DEF\uFF1F"
    - "\u60A8\u662F\u5426\n\u66F4\u559C\u6B61\n\u56F0\u96E3\u7684\u9053\u8DEF\uFF1F"

  - Term: "subtitle\x2fe21t17"
    TermType: 0
    Description: 
    Languages:
    - "Really? You think you can stop me?"
    - "\u662F\u5417\uFF0C\u4F60\u8FD8\u662F\u8981\u963B\u788D\u6211\u5417\uFF1F"
    - "\u662F\u55CE\uFF0C\u4F60\u9084\u662F\u8981\u963B\u7919\u6211\u55CE\uFF1F"
    - "\u305D\u3046\uFF1F\u307E\u305F\u79C1\u306E\u90AA\u9B54\u3092\u3059\u308B\u306E\u304B\uFF1F"

  - Term: "subtitle\x2fe1t14.1"
    TermType: 0
    Description: 
    Languages:
    - "Goodnight, ICEY."
    - "\u827E\u5E0C\uFF0C\u665A\u5B89"
    - "\u827E\u5E0C\uFF0C\u665A\u5B89"
    - "\u30A2\u30A4\u30B7\u30FC\u3001\u304A\u3084\u3059\u307F"
    - "Bonne nuit, ICEY."
    - "Buenas noches, ICEY."

  - Term: "subtitle\x2fe21t13"
    TermType: 0
    Description: 
    Languages:
    - "I need your help."
    - "\u800C\u6211\u73B0\u5728\uFF0C\u9700\u8981\u4F60\u7684\u5E2E\u52A9"
    - "\u800C\u6211\u73FE\u5728\uFF0C\u9700\u8981\u4F60\u7684\u8AAC\u660E"
    - "\u3044\u307E\u3001\u8AAC\u660E\u3057\u3066\u304F\u3060\u3055\u3044"

  - Term: "subtitle\x2fe12t1.5"
    TermType: 0
    Description: 
    Languages:
    - "Wait... wait!"
    - "\u4F60\u7B49\u7B49\u2026\u2026\u7B49\u4E0B\uFF01"
    - "\u4F60\u7B49\u7B49\u2026\u2026\u7B49\u4E0B\uFF01"
    - "\u5F85\u3063\u3066\u3001\u5F85\u3063\u3066\u3088\uFF01"
    - "Attendez\u2026 attendez !"
    - "\u00A1Espera, espera!..."

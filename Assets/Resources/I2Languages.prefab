    Flags: 000000000000
  - Term: "subtitle\x2fe16t9"
    TermType: 0
    Description: 
    Languages:
    - "I'll never forget this!"
    - "\u6211\u8981\u5168\u90E8\u8BB0\u4E0B\u6765\uFF01"
    - "\u6211\u8981\u5168\u90E8\u8A18\u4E0B\u4F86\uFF01"
    - "\u5168\u90E8\u899A\u3048\u3066\u308B\u304B\u3089\u306A\uFF01"
    - "Je n'oublierai jamais \u00E7a !"
    - "\u00A1De esta me voy a acordar!"

    - "Narrator system offline\nrestart .\x2fICEY.bin"
    - "\u65C1\u767D\u7CFB\u7EDF\u635F\u574F\n\u91CD\u542F .\x2f\u827E\u5E0C.bin"
    - "\u65C1\u767D\u7CFB\u7D71\u640D\u58DE\nrestart .\x2fICEY.bin"
    - "\u30CA\u30EC\u30FC\u30BF\u30FC\u30B7\u30B9\u30C6\u30E0\u7834\u640D\nrestart .\x2fICEY.bin"
    - "Syst\u00E8me du narrateur non-connect\u00E9\nred\u00E9marre .\x2fICEY.bin"

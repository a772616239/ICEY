    - "\u4F60\u505A\u5230\u4E86\u2026\u2026\u5929\u554A\uFF0C\u4F60\u505A\u5230\u4E86"
    - "\u4F60\u505A\u5230\u4E86\u2026\u2026\u5929\u554A\uFF0C\u4F60\u505A\u5230\u4E86"
    - "\u3067\u304D\u305F\uFF01\u2026..\u306A\u3093\u3066\u3053\u3063\u305F\uFF01\u672C\u5F53\u306B\u3067\u304D\u305F\uFF01"

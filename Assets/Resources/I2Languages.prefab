    - "\u4FEE\u6539\u5185\u90E8\u6240\u6709\u663E\u793A\u5668"
    - "\u4FEE\u6539\u5167\u90E8\u6240\u6709\u986F\u793A\u5668"
    - "\u5185\u90E8\u306E\u30E2\u30CB\u30BF\u30FC\u3092\u5168\u90E8\u30CF\u30C3\u30AD\u30F3\u30B0\u3057\u307E\u3059"
    - "Changez les \u00E9crans"
    - "Modificar las pantallas"

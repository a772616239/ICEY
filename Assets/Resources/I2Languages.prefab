    - "Aaaahahahaha!"
    - "\u54FC\u54FC\u54FC\u54FC\u54FC\u54FC\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8"
    - "\u54FC\u54FC\u54FC\u54FC\u54FC\u54FC\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8\u54C8"
    - "\u30D5\u30C3\u30D5\u30C3\u30D5\u30C3\u3001\u3042\u30FC\u306F\u3063\u306F\u3063\u306F\u3063\u306F\u3063\u306F\u3063"

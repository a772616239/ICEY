    - "\u60A8\u662F\u5426\n\u6458\u4E0B\u4E86\n\u9762\u5177\uFF1F"
    - "\u3042\u306A\u305F\u306F\u4EEE\u9762\u3092\u5916\u3057\u307E\u3057\u305F\u304B\uFF1F"

    - "\u201C\u8BF7\u957F\u6309\u5C4F\u5E55\u5F00\u59CB\u6E38\u620F\u201D"
    - "\u201C\u8ACB\u9577\u6309\u87A2\u5E55\u958B\u59CB\u904A\u6232\u201D"
    - "\u300C  \u25B3  \u9577\u62BC\u3057\u3067\u30B2\u30FC\u30E0\u30B9\u30BF\u30FC\u30C8\u300D"
    - "\"VEUILLEZ APPUYER LONGTEMPS SUR L'\u00C9CRAN POUR COMMENCER LE JEU\""
    - "\"MANT\u00C9N PULSADA LA PANTALLA PARA COMENZAR\""

  - Term: "subtitle\x2fe10t15.2"
    TermType: 0
    Description: 
    Languages:
    - "Does that mean that I'm sitting here talking to myself?"
    - "\u96BE\u9053\u8BF4\uFF0C\u5C31\u6211\u4E00\u4E2A\u4EBA\u5728\u778E\u53E8\u53E8\uFF1F"
